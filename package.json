{
  "name": "purrps",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "git:setup": "node scripts/git/setup.mjs",
    "git:check": "node scripts/git/check-files.mjs",
    "task:commit": "node scripts/git/task-commit.mjs",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@purrps/config": "workspace:*"
  }
}
