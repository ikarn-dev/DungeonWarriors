{
  "name": "purrps",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "git:setup": "node scripts/git/setup.mjs",
    "git:check": "node scripts/git/check-files.mjs",
    "task:commit": "node scripts/git/task-commit.mjs",
    "typecheck": "pnpm --recursive typecheck && node apps/web/node_modules/typescript/bin/tsc --noEmit --project tests/tsconfig.json",
    "test:web": "node apps/web/node_modules/vitest/vitest.mjs run --config tests/vitest.config.mts",
    "test:program": "rustup run 1.89.0 cargo test --locked --manifest-path apps/purrps-game-program/Cargo.toml -p purrps-game --test rule_contracts --test account_contracts --test protocol_contracts --test publication_contracts",
    "test:program:integration": "rustup run 1.89.0 cargo test --locked --manifest-path apps/purrps-game-program/Cargo.toml -p purrps-game --test program_admin --test test_initialize",
    "test:tooling": "node --test tests/scripts/git/*.test.mjs tests/scripts/program/*.test.mjs",
    "program:export-client": "node scripts/program/export-client.mjs",
    "test:providers": "node --test tests/scripts/providers/*.test.mjs",
    "check:providers": "node --env-file=apps/web/.env scripts/providers/check-readiness.mjs",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@purrps/config": "workspace:*"
  }
}
