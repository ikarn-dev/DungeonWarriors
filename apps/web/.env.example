# Server-only Helius/Upstash credentials. Never use NEXT_PUBLIC_ for these.
APP_ORIGIN=
HELIUS_DEVNET_RPC_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public Devnet Router and one approved regional ER endpoint/identity pair.
MAGICBLOCK_ROUTER_HTTP_URL=
MAGICBLOCK_ER_HTTP_URL=
MAGICBLOCK_ER_WS_URL=
MAGICBLOCK_VALIDATOR_IDENTITY=
MAGICBLOCK_ORACLE_BTC_WRITE_AUTHORITY=
MAGICBLOCK_ORACLE_ETH_WRITE_AUTHORITY=
MAGICBLOCK_ORACLE_SOL_WRITE_AUTHORITY=

# Explicit oracle policy; integer seconds and signed exponents in [-18, 18].
ORACLE_MAX_AGE_SECONDS=
ORACLE_MAX_FUTURE_SKEW_SECONDS=
ORACLE_MIN_EXPONENT=
ORACLE_MAX_EXPONENT=

# Public sponsor address and bounded SOL policy. This check never loads a key.
SPONSOR_PUBLIC_KEY=
SPONSOR_MIN_BALANCE_LAMPORTS=
SPONSOR_OPERATION_LIMIT_LAMPORTS=
SPONSOR_COMPLETION_RESERVE_LAMPORTS=
SPONSOR_MAX_ATTEMPTS=
