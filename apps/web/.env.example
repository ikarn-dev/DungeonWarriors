# Server-only Helius/Upstash credentials. Never use NEXT_PUBLIC_ for these.
# Exact site origin. https in deployments; http://localhost:3000 for local development.
APP_ORIGIN=
HELIUS_DEVNET_RPC_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy runner recovery only: Router, regional ER identity and oracle policy.
# Catacomb Quest does not use these for movement, rooms or gate outcomes.
MAGICBLOCK_ROUTER_HTTP_URL=
MAGICBLOCK_ER_HTTP_URL=
MAGICBLOCK_ER_WS_URL=
MAGICBLOCK_VALIDATOR_IDENTITY=
# Enable after deploying the program upgrade and verifying a funded Hydra cranker.
DUNGEON_ER_SETTLEMENT_ENABLED=false
MAGICBLOCK_ORACLE_BTC_WRITE_AUTHORITY=
MAGICBLOCK_ORACLE_ETH_WRITE_AUTHORITY=
MAGICBLOCK_ORACLE_SOL_WRITE_AUTHORITY=

# Explicit oracle policy; integer seconds and signed exponents in [-18, 18].
ORACLE_MAX_AGE_SECONDS=
ORACLE_MAX_FUTURE_SKEW_SECONDS=
ORACLE_MIN_EXPONENT=
ORACLE_MAX_EXPONENT=

# Public sponsor address and bounded SOL policy. This check never loads a key.
SPONSOR_PUBLIC_KEY=
SPONSOR_MIN_BALANCE_LAMPORTS=
SPONSOR_OPERATION_LIMIT_LAMPORTS=
SPONSOR_COMPLETION_RESERVE_LAMPORTS=
SPONSOR_MAX_ATTEMPTS=

# Dungeon replay verifier and committed-secret HMAC key. A dedicated 64-byte
# keypair encoded in base64. Retain it while expeditions remain unsettled.
# It signs verified results within the frozen wager cap and must differ from the sponsor.
BROWSER_VERIFIER_SECRET_KEY=

# Dedicated operational key only; never use the program upgrade/admin key.
# Base64 of the 64-byte Solana keypair; Vercel server secret, never NEXT_PUBLIC_.
SPONSOR_SECRET_KEY=
SPONSOR_HOURLY_BUDGET_LAMPORTS=

# Optional server-only Sentry project DSN for operational metrics.
SENTRY_DSN=
